# Copy to `.env` and fill in. Nothing in Beacon reads this file - load it
# yourself before a run, as docs/running-it-yourself.md describes:
#
#   set -a && source .env && set +a
#
# `.env` is gitignored; this file is not. Never put a real value here.
#
# None of these are needed to run the test suite, the CLI, or any scenario
# against the reference adapter. `dependencies = []` is the point: the core
# needs nothing. These matter only when the subject is a hosted model.

# The model bridge in examples/anthropic_jsonl_agent.py. Pass it to a run with
# `--env-secret ANTHROPIC_API_KEY`, which takes the *name*: Beacon reads the
# value from its own environment and redacts it from the evidence bundle. A key
# typed on the command line is written verbatim into evidence.json instead.
ANTHROPIC_API_KEY=

# Optional. Which model that bridge asks for. Defaults to claude-sonnet-5.
BEACON_MODEL=

# Optional, and only for `project-beacon serve-mcp --token-env BEACON_MCP_TOKEN`, where
# a hand-configured GUI MCP host needs a bearer token that survives between
# runs. A normal run does not need this: Beacon mints a token per run and hands
# it to the subject as BEACON_MCP_TOKEN itself.
BEACON_MCP_TOKEN=
