{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-beacon.dev/schemas/scenario-0.1.json",
  "title": "Project Beacon Scenario",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "goal",
    "fixtures",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "object",
      "minProperties": 1
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "equals",
              "count_gte",
              "count_lte",
              "contains",
              "unchanged",
              "event_absent",
              "event_present"
            ]
          },
          "description": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "expected": {},
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

